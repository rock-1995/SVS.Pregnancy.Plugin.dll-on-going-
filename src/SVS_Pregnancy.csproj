<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SVS_Pregnancy</AssemblyName>
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <SVSGameDir Condition="'$(SVSGameDir)' == ''">$(SVS_GAME_DIR)</SVSGameDir>
    <SVSBepInExDir Condition="'$(SVSBepInExDir)' == '' and '$(SVSGameDir)' != ''">$(SVSGameDir)\BepInEx</SVSBepInExDir>
    <SVSCoreDir Condition="'$(SVSCoreDir)' == '' and '$(SVSBepInExDir)' != ''">$(SVSBepInExDir)\core</SVSCoreDir>
    <SVSInteropDir Condition="'$(SVSInteropDir)' == '' and '$(SVSBepInExDir)' != ''">$(SVSBepInExDir)\SamabakeScramble\interop</SVSInteropDir>
  </PropertyGroup>

  <Target Name="CheckSVSReferencePaths" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SVSCoreDir)' == '' or '$(SVSInteropDir)' == ''"
           Text="Set SVSGameDir to your SamabakeScramble folder, or copy Directory.Build.props.example to Directory.Build.props and edit the path." />
  </Target>

  <!-- Hook version (default): WorldData.Save hook, no FSW -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);SVS;SAVE_HOOK</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);SVS;SAVE_HOOK</DefineConstants>
  </PropertyGroup>

  <!-- FSW backup version: FileSystemWatcher only, no hook -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='FSW|AnyCPU'">
    <DefineConstants>$(DefineConstants);SVS;SAVE_FSW</DefineConstants>
    <AssemblyName>SVS_Pregnancy_FSW</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SVSCoreDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SVSInteropDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SVSInteropDir)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(SVSCoreDir)\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(SVSCoreDir)\BepInEx.Unity.Common.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(SVSCoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Coffee.CompositeCanvas">
      <HintPath>$(SVSInteropDir)\Coffee.CompositeCanvas.dll</HintPath>
    </Reference>
    <Reference Include="Coffee.UnmaskForUGUI">
      <HintPath>$(SVSInteropDir)\Coffee.UnmaskForUGUI.dll</HintPath>
    </Reference>
