    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(SVSInteropDir)\Il2CppSystem.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(SVSInteropDir)\Il2CppSystem.Core.dll</HintPath>
